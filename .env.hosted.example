# Non-secret hosted container configuration. Secrets are mounted separately.
APP_IMAGE=ghcr.io/enggp/thunderstrux@sha256:replace-with-64-lowercase-hex-characters
AUTH_URL=https://app.example.com
NEXTAUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
TRUSTED_APP_ORIGINS=https://app.example.com
MFA_ENFORCEMENT_MODE=enforce
LEGACY_ORGANISATION_ACCESS_MODE=deny
RATE_LIMIT_KEY_PREFIX=thunderstrux-production
RATE_LIMIT_TRUSTED_PROXY_HEADER=x-forwarded-for
EMAIL_FROM=Thunderstrux <tickets@example.com>
PORT=3000
APP_CPUS=1.0
APP_MEMORY_LIMIT=1g
APP_PIDS_LIMIT=256
OPS_CPUS=1.0
OPS_MEMORY_LIMIT=1g
OPS_PIDS_LIMIT=128

# External secret names. The platform must mount their values at the targets
# declared in docker-compose.hosted.yml.
DATABASE_URL_SECRET_NAME=thunderstrux_database_url
AUTH_SECRET_NAME=thunderstrux_auth_secret
MFA_ENCRYPTION_KEY_SECRET_NAME=thunderstrux_mfa_encryption_key
RATE_LIMIT_REDIS_URL_SECRET_NAME=thunderstrux_rate_limit_redis_url
STRIPE_SECRET_KEY_SECRET_NAME=thunderstrux_stripe_secret_key
STRIPE_WEBHOOK_SECRET_NAME=thunderstrux_stripe_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET_NAME=thunderstrux_stripe_connect_webhook_secret
RESEND_API_KEY_SECRET_NAME=thunderstrux_resend_api_key

# Back up this separate 32-byte base64 key with encrypted database recovery materials.
NOTIFICATION_ENCRYPTION_KEY_SECRET_NAME=thunderstrux_notification_encryption_key
