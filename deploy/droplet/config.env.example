# T43b: /opt/thunderstrux/config.env on the pilot Droplet. Non-secret settings
# only; secret values are files in /etc/thunderstrux/secrets (see the list in
# docker-compose.droplet.yml). The deploy writes APP_IMAGE and OPS_IMAGE per
# release, so they aren't set here.

# Public edge (Caddy). DNS for SITE_ADDRESS must point at the Droplet's
# reserved IP before the first deploy; Let's Encrypt registers ACME_EMAIL.
SITE_ADDRESS=app.example.com
ACME_EMAIL=ops@example.com

AUTH_URL=https://app.example.com
NEXTAUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
TRUSTED_APP_ORIGINS=https://app.example.com
MFA_ENFORCEMENT_MODE=enforce
LEGACY_ORGANISATION_ACCESS_MODE=deny
RATE_LIMIT_KEY_PREFIX=thunderstrux-production
# The overlay sets the client-IP header Caddy overwrites; this value is replaced.
RATE_LIMIT_TRUSTED_PROXY_HEADER=x-thunderstrux-client-ip
EMAIL_FROM=Thunderstrux <tickets@example.com>
# Optional. Shown on the public Help and Privacy pages; left out while empty.
PLATFORM_SUPPORT_EMAIL=
PORT=3000

# Spaces in syd1 (S3-compatible; keys are secret files).
ASSET_STORAGE_ENDPOINT=https://syd1.digitaloceanspaces.com
ASSET_STORAGE_BUCKET=thunderstrux-assets
ASSET_STORAGE_REGION=syd1
ASSET_STORAGE_PATH_STYLE=false

# Sized for a 2 vCPU / 4 GiB Droplet: the app, Caddy and six worker loops.
APP_CPUS=1.0
APP_MEMORY_LIMIT=1g
APP_PIDS_LIMIT=256
OPS_CPUS=0.5
OPS_MEMORY_LIMIT=512m
OPS_PIDS_LIMIT=128
WORKER_TIMEOUT_SECONDS=300

THUNDERSTRUX_SECRETS_DIR=/etc/thunderstrux/secrets
THUNDERSTRUX_BACKUP_DIR=/var/lib/thunderstrux/backups
