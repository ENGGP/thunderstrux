FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder
WORKDIR /src
ADD --checksum=sha256:217b507e7457d10629e837cebea6542d8b7685819dafbb56ef910330594af0e1 https://codeload.github.com/seaweedfs/seaweedfs/tar.gz/530be3e37337488ecc34d58441e0bc476e121c93 /tmp/source.tar.gz
# Rebuild upstream 4.48 with fixes for its Go runtime and x/net advisories.
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 \
  && go mod edit -require=golang.org/x/net@v0.60.0 \
  && go mod tidy \
  && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /weed ./weed

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates \
  && mkdir /data \
  && chown 1000:1000 /data
COPY --from=builder /weed /usr/bin/weed
USER 1000:1000
ENTRYPOINT ["/usr/bin/weed"]
CMD ["mini", "-dir=/data"]
