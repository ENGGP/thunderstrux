{
  "name": "thunderstrux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/assert-docker-runtime.mjs --block-next-dev && node scripts/clean-next-dev.mjs && next dev --turbopack --hostname 0.0.0.0",
    "dev:webpack": "node scripts/assert-docker-runtime.mjs --block-next-dev && node scripts/clean-next-dev.mjs && next dev --webpack --hostname 0.0.0.0",
    "dev:doctor": "node scripts/doctor-dev.mjs",
    "build": "node scripts/prepare-next-build.mjs && pnpm prisma:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:integration",
    "security:audit": "pnpm audit --audit-level high",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "email:outbox:process": "node scripts/process-email-outbox.mjs",
    "stale-orders:process": "node scripts/process-stale-orders.mjs",
    "db:integrity:audit": "node scripts/audit-db-integrity.mjs",
    "seed": "prisma db seed",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:clean": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --force-recreate",
    "docker:prod": "docker compose up --build",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:restart": "docker compose restart app",
    "docker:build": "docker compose build app",
    "docker:rebuild": "docker compose up -d --build --force-recreate app",
    "docker:migrate": "docker compose exec app pnpm prisma:migrate",
    "docker:seed": "docker compose exec app pnpm seed",
    "docker:db:sync": "docker compose exec app pnpm prisma:migrate && docker compose exec app pnpm prisma:generate && docker compose exec app pnpm seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jiti": "2.6.1",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "stripe": "22.0.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "20.19.25",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.0.0"
}
