model NotificationOutbox {
  staffInviteId String?
  staffInviteVersion Int?
  staffInvite OrganisationStaffInvite? @relation(fields: [staffInviteId], references: [id], onDelete: SetNull)
  @@index([staffInviteId])
  authTokenId         String?
  authToken           AuthToken? @relation(fields: [authTokenId], references: [id], onDelete: SetNull)
  @@index([authTokenId])
  guestAccessGrantId  String?
  guestAccessGrant    GuestAccessGrant? @relation(fields: [guestAccessGrantId], references: [id], onDelete: SetNull)
  @@index([guestAccessGrantId])
  id String @id @default(cuid())
  eventKey String
  recipient String
  template String
  templateVersion Int @default(1)
  privacy String
  userId String?
  organisationId String?
  encryptedPayload String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  processingStartedAt DateTime?
  processingToken String?
  firstAttemptAt DateTime?
  expiresAt DateTime?
  acceptedAt DateTime?
  providerMessageId String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  @@unique([eventKey, recipient, templateVersion])
  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
  @@index([organisationId, privacy, status, createdAt])
  @@index([userId])
}

// T20: a membership or merchandise purchase, kept apart from ticket orders.
// One society and one family per order; every line repeats both, and the
// composite key makes the database refuse a line of another family or
// society. Buyer, seller and line snapshots never change once written.
enum CommerceKind {
  membership
  merchandise
}

enum CommerceLifecycleEventType {
  order_created
  stripe_session_attached
  payment_fulfilled
  free_fulfilled
  order_failed
  order_expired
  compensation_required
  free_cancelled
  refund_requested
  refund_pending
  refunded
  refund_failed
  pickup_ready
  pickup_collected
}

enum MerchandisePickupStatus {
  pending
  ready
  collected
}

model CommerceOrder {
  id                         String        @id @default(cuid())
  organisationId             String
  kind                       CommerceKind
  // A member buys memberships; merchandise may also go to a verified guest.
  userId                     String?
  guestIdentityId            String?
  status                     OrderStatus   @default(pending)
  paymentKind                PaymentKind
  currency                   String        @default("aud")
  totalAmount                Int
  // The platform fee, taken from the society's share; the buyer pays totalAmount.
  feeAmount                  Int           @default(0)
  buyerEmailSnapshot         String
  buyerNameSnapshot          String?
  sellerName                 String
  sellerSupportEmail         String?
  sellerStripeAccountId      String?
  feePolicyVersion           String?
  // A pending paid order's hold ends with its Stripe Session (T21).
  expiresAt                  DateTime?
  stripeSessionId            String?       @unique
  stripePaymentIntentId      String?
  requiresCompensationReview Boolean       @default(false)
  reviewReason               String?
  version                    Int           @default(1)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  paidAt                     DateTime?
  fulfilledAt                DateTime?
  failedAt                   DateTime?
  failureReason              String?
  // A free order cancelled by staff (T23b): never a refund.
  cancelledAt                DateTime?
  cancelledByUserId          String?
  cancellationReason         String?
  // The financial fence for a Stripe-paid order (T23c), as Order.refundStatus.
  refundStatus               OrderRefundStatus?
  // A fulfilled merchandise order's pickup (T28a); staff steps bump `version`.
  pickupStatus               MerchandisePickupStatus?

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  cancelledBy      User?                    @relation("CommerceOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestIdentity    GuestIdentity?           @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  lines            CommerceOrderLine[]
  lifecycleEvents  CommerceLifecycleEvent[]
  checkoutAttempt  CheckoutAttempt?
  refundRequests   RefundRequest[]
  guestAccessGrants GuestAccessGrant[]

  @@unique([id, organisationId, kind], map: "CommerceOrder_id_organisation_kind_key")
  @@index([organisationId, createdAt, id])
  @@index([organisationId, pickupStatus, createdAt, id])
  @@index([userId, createdAt, id])
  @@index([guestIdentityId])
  @@index([status, expiresAt])
}

model CommerceOrderLine {
  id             String       @id @default(cuid())
  orderId        String
  organisationId String
  kind           CommerceKind
  lineNumber     Int
  quantity       Int
  unitAmount     Int
  lineAmount     Int
  currency       String
  nameSnapshot   String
  // Size, colour or other variant label for merchandise.
  variantSnapshot String?
  // The term a membership line bought.
  termStartsAt   DateTime?
  termEndsAt     DateTime?
  // The plan a membership line bought (T22).
  membershipProductId String?
  // The option a merchandise line sold (T27a); a pending order's lines hold its stock.
  merchandiseVariantId String?
  createdAt      DateTime     @default(now())

  order             CommerceOrder      @relation(fields: [orderId, organisationId, kind], references: [id, organisationId, kind], onDelete: Restrict)
  membershipProduct MembershipProduct? @relation(fields: [membershipProductId, organisationId], references: [id, organisationId], onDelete: Restrict)
  membershipGrant   MembershipGrant?
  merchandiseVariant MerchandiseVariant? @relation(fields: [merchandiseVariantId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([orderId, lineNumber])
  @@unique([id, organisationId])
  @@unique([orderId, merchandiseVariantId])
  @@index([membershipProductId])
  @@index([merchandiseVariantId])
}

enum MembershipPlanStatus {
  draft
  published
  archived
}

enum MembershipEntitlement {
  member_prices
  members_only_events
}

// A fixed-term membership a society sells (T22). Terms are [startsAt, endsAt);
// once sold, name, term, price and rights never change.
model MembershipProduct {
  id                 String                  @id @default(cuid())
  organisationId     String
  name               String
  description        String                  @default("")
  priceAmount        Int
  currency           String                  @default("aud")
  startsAt           DateTime
  endsAt             DateTime
  entitlements       MembershipEntitlement[] @default([])
  entitlementVersion Int                     @default(1)
  status             MembershipPlanStatus    @default(draft)
  publishedAt        DateTime?
  archivedAt         DateTime?
  version            Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  lines        CommerceOrderLine[]
  grants       MembershipGrant[]

  @@unique([id, organisationId])
  @@index([organisationId, status, startsAt, id])
}

// One member's membership from one purchased line; state comes from the
// clock and revokedAt (T23 writes these).
model MembershipGrant {
  id                  String                  @id @default(cuid())
  userId              String
  organisationId      String
  membershipProductId String
  commerceOrderLineId String                  @unique
  startsAt            DateTime
  endsAt              DateTime
  entitlements        MembershipEntitlement[]
  entitlementVersion  Int
  grantedAt           DateTime                @default(now())
  revokedAt           DateTime?
  revokedByUserId     String?
  revocationReason    String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  product      MembershipProduct @relation(fields: [membershipProductId, organisationId], references: [id, organisationId], onDelete: Restrict)
  line         CommerceOrderLine @relation(fields: [commerceOrderLineId, organisationId], references: [id, organisationId], onDelete: Restrict)
  revokedBy    User?             @relation("MembershipGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  memberPricedOrders Order[]

  // Same line, pinned to the grant's society (required for the composite relation).
  @@unique([commerceOrderLineId, organisationId])
@@index([userId, organisationId, startsAt])
  @@index([organisationId, startsAt, id])
  @@index([membershipProductId])
}

model CommerceLifecycleEvent {
  id              String                     @id @default(cuid())
  commerceOrderId String
  sequence        Int
  type            CommerceLifecycleEventType
  source          OrderLifecycleSource
  actorUserId     String?
  stripeEventId   String?
  fromStatus      OrderStatus?
  toStatus        OrderStatus?
  reason          String?
  facts           Json?
  createdAt       DateTime                   @default(now())

  commerceOrder CommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([commerceOrderId, sequence])
}

enum MerchandiseProductStatus {
  draft
  published
  archived
}

// Something a society sells for pickup (T25). Never deleted: archived
// products leave the shop and can be restored as drafts.
model MerchandiseProduct {
  id               String                   @id @default(cuid())
  organisationId   String
  name             String
  description      String                   @default("")
  status           MerchandiseProductStatus @default(draft)
  publishedAt      DateTime?
  // First publish; never cleared, so options of a product once on sale stop selling instead of being removed.
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  images       MerchandiseProductImage[]
  variants     MerchandiseVariant[]

  @@unique([id, organisationId])
  @@index([organisationId, status, createdAt, id])
}

// Up to four photos per product, in order, from the same society's images.
model MerchandiseProductImage {
  id             String   @id @default(cuid())
  productId      String
  organisationId String
  assetId        String
  position       Int
  createdAt      DateTime @default(now())

  product MerchandiseProduct @relation(fields: [productId, organisationId], references: [id, organisationId], onDelete: Restrict)
  asset   Asset              @relation(fields: [assetId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([productId, position])
  @@unique([productId, assetId])
  @@index([assetId])
}

// One thing a buyer picks: colour and size (either may be blank), price and
// stock left. The SKU is unique in the society for good.
model MerchandiseVariant {
  id             String    @id @default(cuid())
  productId      String
  organisationId String
  colour         String    @default("")
  size           String    @default("")
  sku            String
  priceAmount    Int
  currency       String    @default("aud")
  remaining      Int
  position       Int       @default(0)
  version        Int       @default(1)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product    MerchandiseProduct  @relation(fields: [productId, organisationId], references: [id, organisationId], onDelete: Restrict)
  orderLines CommerceOrderLine[]

  @@unique([organisationId, sku])
  @@unique([id, organisationId])
  @@index([productId, position, id])
}
