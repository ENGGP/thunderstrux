generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  password                String
  emailVerifiedAt         DateTime?
  authVersion             Int                  @default(0)
  disabledAt              DateTime?
  closedAt                DateTime?
  authTokens              AuthToken[]
  securityEvents          AccountSecurityEvent[]
  accountRole             AccountRole          @default(member)
  firstName               String?
  lastName                String?
  displayName             String?
  phone                   String?
  studentNumber           String?
  onboardingCompletedAt   DateTime?
  createdAt               DateTime             @default(now())
  organisationMemberships OrganisationMember[]
  organisationStaff       OrganisationStaff[] @relation("StaffUser")
  staffMembershipsInvited OrganisationStaff[] @relation("StaffInviter")
  staffInvitesSent        OrganisationStaffInvite[] @relation("StaffInviteInviter")
  staffInvitesAccepted    OrganisationStaffInvite[] @relation("StaffInviteAcceptor")
  revokedStaffMemberships OrganisationStaff[] @relation("StaffRevoker")
  auditLogs               AuditLog[]
  uploadedAssets          Asset[]
  mfa                     UserMfa?
  mfaRecoveryCodes        MfaRecoveryCode[]
  mfaGrants               MfaGrant[]
  orderLifecycleEvents    OrderLifecycleEvent[]     @relation("OrderLifecycleActor")
  ownedOrganisation       Organisation?        @relation("OrganisationAccount")
  notificationJobs        NotificationOutbox[]
  orders                  Order[]              @relation("OrderBuyer")
  refundRequests          RefundRequest[]
  resolvedDisputes        PurchaseDispute[]
  cancelledOrders         Order[]              @relation("OrderCancelledBy")
  commerceOrders          CommerceOrder[]
  membershipGrants        MembershipGrant[]
  revokedMembershipGrants MembershipGrant[]  @relation("MembershipGrantRevokedBy")
  cancelledCommerceOrders CommerceOrder[]    @relation("CommerceOrderCancelledBy")
  commerceLifecycleEvents CommerceLifecycleEvent[]
  reservations            TicketReservation[]

  @@index([accountRole])
}

model AuthToken {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  purpose        String
  userId         String
  email          String
  newEmail       String?
  authVersion    Int
  callbackPath   String   @default("/dashboard")
  expiresAt      DateTime
  consumedAt     DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications  NotificationOutbox[]

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AccountSecurityEvent {
  id           String   @id @default(cuid())
  userId       String
  type         String
  authVersion  Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model Organisation {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  description         String               @default("")
  supportEmail        String               @default("")
  refundPolicy        String               @default("")
  pickupPolicy        String               @default("")
  timeZone            String               @default("Australia/Brisbane")
  onboardingCompletedAt DateTime?
  profileVersion      Int                  @default(1)
  logoAssetId         String?
  coverAssetId        String?
  logoAsset           Asset?               @relation("SocietyLogo", fields: [logoAssetId, id], references: [id, organisationId], onDelete: Restrict)
  coverAsset          Asset?               @relation("SocietyCover", fields: [coverAssetId, id], references: [id, organisationId], onDelete: Restrict)
  accountUserId       String?              @unique
  stripeAccountId     String?
  stripeAccountStatus String?
  stripeChargesEnabled Boolean              @default(false)
  stripePayoutsEnabled Boolean              @default(false)
  stripeDetailsSubmitted Boolean            @default(false)
  createdAt           DateTime             @default(now())
  accountUser         User?                @relation("OrganisationAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  notificationJobs    NotificationOutbox[]
  members             OrganisationMember[]
  staff               OrganisationStaff[]
  staffInvites        OrganisationStaffInvite[]
  auditLogs           AuditLog[]
  events              Event[]
  orders              Order[]
  tickets             Ticket[]
  reservations        TicketReservation[]
  assets              Asset[]
  refundRequests      RefundRequest[]
  purchaseDisputes    PurchaseDispute[]
  commerceOrders      CommerceOrder[]
  membershipProducts  MembershipProduct[]
  merchandiseProducts MerchandiseProduct[]
  membershipGrants    MembershipGrant[]

  @@index([accountUserId])
  @@index([stripeAccountId])
  @@index([name, id])
}

model Asset {
  id               String       @id @default(cuid())
  organisationId   String
  uploadedByUserId String
  storageKey       String       @unique
  kind             String
  contentType      String       @default("image/webp")
  byteSize         Int
  width            Int
  height           Int
  sha256           String
  status           String       @default("pending")
  createdAt        DateTime     @default(now())
  readyAt          DateTime?
  deletedAt        DateTime?
  unreferencedAt   DateTime?    @default(now())
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  uploadedBy       User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  logoProfiles     Organisation[] @relation("SocietyLogo")
  coverProfiles    Organisation[] @relation("SocietyCover")
  eventHeroes      Event[]        @relation("EventHero")
  productImages    MerchandiseProductImage[]

  @@unique([id, organisationId])
  @@index([organisationId, status])
  @@index([status, createdAt])
  @@index([uploadedByUserId])
}

model OrganisationMember {
  id             String           @id @default(cuid())
  userId         String
  organisationId String
  role           OrganisationRole
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([userId])
}

model OrganisationStaff {
  id             String                  @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationStaffRole
  status         OrganisationStaffStatus @default(active)
  invitedById    String?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User                    @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?                   @relation("StaffInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  revokedBy      User?                   @relation("StaffRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, role, status])
  @@index([invitedById])
  @@index([revokedById])
}

model OrganisationStaffInvite {
  id             String                @id @default(cuid())
  organisationId String
  email          String
  role           OrganisationStaffRole
  version        Int                   @default(1)
  notifications  NotificationOutbox[]
  tokenHash      String                @unique
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy      User                  @relation("StaffInviteInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy     User?                 @relation("StaffInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organisationId, email])
  @@index([expiresAt])
  @@index([email, acceptedAt, revokedAt])
  @@index([invitedById])
  @@index([acceptedById])
}

model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

model UserMfa {
  userId                 String   @id
  encryptedSecret        String?
  pendingEncryptedSecret String?
  pendingExpiresAt       DateTime?
  enabledAt              DateTime?
  lastAcceptedStep       BigInt?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaGrant {
  sessionDigest String   @id
  userId        String
  verifiedAt    DateTime
  expiresAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Event {
  id             String      @id @default(cuid())
  organisationId String
  title          String
  description    String
  startTime      DateTime
  endTime        DateTime
  location       String
  status         EventStatus @default(draft)
  // Optional event-wide ceiling, separate from each ticket type's remaining quantity.
  capacity       Int?
  visibility     EventVisibility @default(public)
  salesCloseAt   DateTime
  saleState      EventSaleState @default(open)
  // Compare-and-swap version for edits, publication and sales changes.
  version        Int         @default(1)
  compensationRefundMode CompensationRefundMode @default(manual_review)
  createdAt      DateTime    @default(now())
  // Optional 16:9 event image: a ready `event` asset of the same society (T11b).
  heroAssetId    String?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  heroAsset      Asset?       @relation("EventHero", fields: [heroAssetId, organisationId], references: [id, organisationId], onDelete: Restrict)
  ticketTypes    TicketType[]
  tickets        Ticket[]
  orders         Order[]
  reservations   TicketReservation[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([status, startTime, id], map: "Event_status_startTime_id_idx")
  @@index([heroAssetId])
}

model TicketType {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  price     Int
  // What a member with the member_prices right pays (T24b); at most price.
  memberPrice Int?
  quantity  Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  orders    Order[]
  reservations TicketReservation[]

  @@index([eventId])
}

model Order {
  id              String       @id @default(cuid())
  organisationId  String
  eventId         String
  ticketTypeId    String
  userId          String?
  status          OrderStatus  @default(pending)
  quantity        Int
  unitPrice       Int
  totalAmount     Int
  stripeSessionId String?      @unique
  createdAt       DateTime     @default(now())
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  requiresCompensationReview Boolean @default(false)
  fulfilmentFailedAt DateTime?
  fulfilmentFailureReason String?
  isManuallyRefunded Boolean @default(false)
  compensationRefundModeSnapshot CompensationRefundMode @default(manual_review)
  ticketEmailSentAt DateTime?
  ticketEmailLastError String?
  ticketEmailResentAt DateTime?
  buyerEmailSnapshot String?
  buyerFirstNameSnapshot String?
  buyerLastNameSnapshot String?
  buyerDisplayNameSnapshot String?
  buyerIdentityCapturedAt DateTime?
  buyerIdentityProvenance String?
  // A verified guest buyer (T16); userId stays null until an explicit member claim.
  guestIdentityId         String?
  // T18a: the financial fence. Set while an ordinary refund is in flight and
  // once it succeeds; compensation refunds never start while it is set.
  refundStatus            OrderRefundStatus?
  // The membership a member-priced order was quoted with, and its rights version (T24b).
  membershipGrantId            String?
  membershipEntitlementVersion Int?
  membershipGrant              MembershipGrant? @relation(fields: [membershipGrantId], references: [id], onDelete: Restrict)
  stripePaymentIntentId   String?
  // T18b: a verified Stripe dispute fences refunds, resends and compensation.
  // It stays set once lost; once won it clears when staff restore the tickets.
  disputeStatus           OrderDisputeStatus?
  // Succeeded refunds made outside Thunderstrux (the Stripe dashboard), as Stripe reports them.
  externalRefundedAmount  Int          @default(0)
  externalRefundReviewedAt DateTime?
  // T18c: a free purchase cancelled by staff. Nothing was charged, so this is
  // never a refund; the order keeps status paid and its original fulfilment.
  cancelledAt             DateTime?
  cancelledByUserId       String?
  cancellationReason      String?
  cancelledBy             User?        @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  // Purchase facts recorded when the order is created; null on legacy rows means unknown.
  paymentKind             PaymentKind
  fulfilledAt             DateTime?
  purchasedTicketTypeName String?
  sellerName              String?
  sellerStripeAccountId   String?
  currency                String       @default("aud")
  feeAmount               Int?
  feePolicyVersion        String?
  snapshotVersion         Int?
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType      TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  user            User?        @relation("OrderBuyer", fields: [userId], references: [id], onDelete: SetNull)
  guestIdentity   GuestIdentity? @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  tickets         Ticket[]
  reservation     TicketReservation?
  emailOutboxJobs EmailOutbox[]
  lifecycleEvents            OrderLifecycleEvent[]
  compensationRefundJob      CompensationRefundJob?
  checkoutAttempt            CheckoutAttempt?
  guestAccessGrants          GuestAccessGrant[]
  refundRequests             RefundRequest[]
  disputes                   PurchaseDispute[]

  @@index([organisationId])
  @@index([eventId])
  @@index([eventId, status, createdAt, id], map: "Order_eventId_status_createdAt_id_idx")
  @@index([ticketTypeId])
  @@index([userId])
  @@index([userId, status, createdAt, id], map: "Order_userId_status_createdAt_id_idx")
  @@index([guestIdentityId])
  @@index([status, createdAt], map: "Order_status_createdAt_idx")
  @@index([membershipGrantId])
}

// One durable record per intended checkout (database spec 6.1). The same actor
// and client key returns the same result; the provider key is Stripe's
// idempotency key, so a retried Session creation can never charge twice.
// T16: an email address proven by a link, for buying without an account. It is
// never a login and never matched to a member's purchases by the string alone.
model GuestIdentity {
  id         String   @id @default(cuid())
  email      String   @unique
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  grants     GuestAccessGrant[]
  orders     Order[]
  commerceOrders CommerceOrder[]
}

// One emailed link. Only its digest is stored; redeeming it by POST starts a
// browser session whose id is also stored only as a digest.
model GuestAccessGrant {
  id               String    @id @default(cuid())
  guestIdentityId  String
  purpose          String
  tokenDigest      String    @unique
  callbackPath     String    @default("/events")
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  sessionDigest    String?   @unique
  sessionExpiresAt DateTime?
  // A purchase link opens this one order and nothing else (T16b), or this
  // one merchandise order; never both.
  orderId          String?
  commerceOrderId  String?
  createdAt        DateTime  @default(now())
  guestIdentity    GuestIdentity @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commerceOrder    CommerceOrder? @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)
  notifications    NotificationOutbox[]

  @@index([guestIdentityId, purpose, createdAt])
  @@index([expiresAt])
  @@index([orderId])
  @@index([commerceOrderId])
}

model CheckoutAttempt {
  id                   String               @id @default(cuid())
  family               CheckoutFamily
  actorKind            CheckoutActorKind
  actorId              String
  operationType        String
  clientIdempotencyKey String
  requestHash          String
  orderId              String?              @unique
  providerOperationKey String               @unique
  stripeSessionId      String?              @unique
  stripeSessionUrl     String?
  // The exact Stripe Session request, replayed with the same key by recovery (T14b).
  providerRequest      Json?
  state                CheckoutAttemptState @default(created)
  reconcileDueAt       DateTime?
  lastOutcome          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // A membership or merchandise purchase (T20); never set together with orderId.
  commerceOrderId      String?              @unique

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commerceOrder CommerceOrder? @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)

  @@unique([actorKind, actorId, family, operationType, clientIdempotencyKey], map: "CheckoutAttempt_actor_key_key")
  @@index([state, reconcileDueAt])
}

model CompensationRefundJob {
  id                    String                  @id @default(cuid())
  orderId               String                  @unique
  state                 CompensationRefundState @default(review_required)
  stripePaymentIntentId String?
  stripeRefundId        String?                 @unique
  amount                Int
  currency              String                  @default("aud")
  attempts              Int                     @default(0)
  nextAttemptAt         DateTime                 @default(now())
  processingStartedAt   DateTime?
  processingToken       String?
  providerStatus        String?
  lastProviderEventAt   DateTime?
  lastErrorCode         String?
  lastErrorAt           DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhookEvents         StripeRefundWebhookEvent[]

  @@index([state, nextAttemptAt, createdAt])
  @@index([state, processingStartedAt])
  @@index([stripePaymentIntentId])
}

// Also journals dispute and outside-refund events (T18b), which link to neither.
model StripeRefundWebhookEvent {
  stripeEventId   String                @id
  refundJobId     String?
  refundRequestId String?
  refundRequest   RefundRequest?        @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)
  eventType       String
  eventCreatedAt  DateTime
  processedAt     DateTime              @default(now())
  refundJob       CompensationRefundJob? @relation(fields: [refundJobId], references: [id], onDelete: SetNull)

  @@index([refundJobId, eventCreatedAt])
  @@index([refundRequestId, eventCreatedAt])
}

// One staff-initiated whole-order refund (T18a). Stripe is called outside the
// database with operationKey as its idempotency key; an unknown outcome is
// looked up at Stripe before the same key is ever sent again.
// A whole-order refund of a ticket order or (T23c) a commerce order, never both.
model RefundRequest {
  id                    String              @id @default(cuid())
  orderId               String?
  commerceOrderId       String?
  organisationId        String
  amount                Int
  currency              String              @default("aud")
  reason                String
  actorUserId           String?
  operationKey          String              @unique
  status                RefundRequestStatus @default(pending)
  stripePaymentIntentId String?
  stripeRefundId        String?             @unique
  destinationAccountId  String?
  providerStatus        String?
  attempts              Int                 @default(0)
  nextAttemptAt         DateTime            @default(now())
  processingToken       String?
  processingStartedAt   DateTime?
  lastErrorCode         String?
  lastProviderEventAt   DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commerceOrder         CommerceOrder?      @relation(fields: [commerceOrderId], references: [id], onDelete: Restrict)
  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor                 User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  webhookEvents         StripeRefundWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([commerceOrderId, createdAt])
  @@index([status, nextAttemptAt])
}

// A Stripe dispute on an order's charge (T18b), kept as Stripe last reported
// it. A dispute is not a refund: the tickets go under review, and only a lost
// dispute voids them; a won one needs staff to restore them with a reason.
model PurchaseDispute {
  id               String       @id @default(cuid())
  orderId          String
  organisationId   String
  stripeDisputeId  String       @unique
  stripeChargeId   String
  amount           Int
  currency         String
  reason           String?
  providerStatus   String
  evidenceDueBy    DateTime?
  closedAt         DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  resolvedBy       User?        @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Ticket {
  id             String       @id @default(cuid())
  orderId        String
  eventId        String
  ticketTypeId   String
  organisationId String
  createdAt      DateTime     @default(now())
  checkedInAt    DateTime?
  issueSequence  Int
  validity       TicketValidity @default(active)
  validityReason String?
  validityChangedAt DateTime?
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([orderId, issueSequence])
  @@index([orderId])
  @@index([eventId])
  @@index([eventId, createdAt, id])
  @@index([eventId, checkedInAt])
  @@index([ticketTypeId])
  @@index([organisationId])
}

model EmailOutbox {
  id                  String            @id @default(cuid())
  orderId             String
  mode                EmailOutboxMode
  status              EmailOutboxStatus @default(pending)
  attempts            Int               @default(0)
  nextAttemptAt       DateTime          @default(now())
  processingStartedAt DateTime?
  processingToken       String?
  lastError           String?
  providerMessageId   String?
  deliveredToProviderAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sentAt              DateTime?
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, processingStartedAt])
  @@index([orderId])
}

model OrderLifecycleEvent {
  id                    String                  @id @default(cuid())
  orderId               String
  sequence              Int
  type                  OrderLifecycleEventType
  source                OrderLifecycleSource
  actorUserId           String?
  stripeEventId         String?
  stripeSessionId       String?
  emailOutboxId         String?
  reason                String?
  fromOrderStatus       OrderStatus?
  toOrderStatus         OrderStatus?
  fromReservationStatus ReservationStatus?
  toReservationStatus   ReservationStatus?
  facts                 Json?
  createdAt             DateTime                @default(now())
  order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor                 User?                   @relation("OrderLifecycleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
  @@index([stripeEventId])
  @@index([emailOutboxId])
  @@index([actorUserId, createdAt])
}

model TicketReservation {
  id             String            @id @default(cuid())
  orderId        String            @unique
  organisationId String
  eventId        String
  ticketTypeId   String
  userId         String?
  quantity       Int
  status         ReservationStatus @default(active)
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  confirmedAt    DateTime?
  releasedAt     DateTime?
  releaseReason  String?
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType     TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketTypeId, status, expiresAt])
  @@index([status, expiresAt], map: "TicketReservation_status_expiresAt_idx")
  @@index([orderId])
  @@index([userId])
}

enum OrganisationRole {
  org_owner
  org_admin
  event_manager
  finance_manager
  content_manager
  member
}

enum OrganisationStaffRole {
  owner
  admin
  event_manager
  finance_manager
  check_in_staff
}

enum OrganisationStaffStatus {
  invited
  active
  revoked
}

enum AccountRole {
